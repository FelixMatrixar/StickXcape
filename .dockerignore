# Built in the image, never copied in: a stale tsbuildinfo would make tsc -b skip the build.
**/node_modules
**/dist
**/*.tsbuildinfo
coverage

# Secrets and local files, including the development account database
**/.env
**/.env.*
!**/.env.example
services/server/data
.git
.github
.claude
plan
*.md
*.log
