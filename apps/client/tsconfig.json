{
  // The game client builds with Vite, so TypeScript only checks it. Workspace packages resolve to
  // their TypeScript sources through the "source" export condition, as in the tests and the lab.
  // noUncheckedIndexedAccess stays off here: the engine and renderer index typed arrays on every
  // line, and the check would only add noise there.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "customConditions": ["source"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
