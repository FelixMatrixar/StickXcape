# Copy this file to .env in the same folder. Never commit .env. Every setting is optional.

PORT=8080

# Origin used in invite links. Without it, links use the address the page was opened at.
# PUBLIC_URL=https://your-tunnel.example.com
# Set to 1 behind one proxy or tunnel (Fly.io, cloudflared) so links and IPs come out right.
# TRUST_PROXY=1

# Meta Model API key (starts with LLM_). Leave it empty to get canned move names and tips.
MODEL_API_KEY=
# Muse Spark 1.1 is the default because it answers about a second faster than 1.3 at the same price.
# AI_MODEL=muse-spark-1.1
# minimal is the fastest level Muse Spark accepts; it rejects none.
# AI_REASONING_EFFORT=minimal
# AI_MOVE_NAMES_PER_DAY=30
# AI_MATCH_TIPS_PER_DAY=60
# Name checks (quick match nicknames, shared arena names) per player; a name already checked is free.
# AI_NAME_CHECKS_PER_DAY=20
# Backdrop checks before a photo arena is shared, per player.
# AI_ARENA_CHECKS_PER_DAY=10

# Accounts and the cloud move library (SQLite). In development they default to services/server/data;
# in production they are off unless this is set. Passkeys work on localhost, or on HTTPS with a domain.
# DATABASE_FILE=/data/sticxcape.db
# LIBRARY_MAX_MOVES=200
# PASSKEYS_PER_IP_PER_10_MIN=30

# Password for /admin and /metrics (sign in as "admin"). Without it they're open locally and off in production.
# ADMIN_TOKEN=
# Slack or Discord webhook for the alert when AI errors pass 5%.
# ALERT_WEBHOOK_URL=

# Folder with the game client's build, served instead of the test page.
# WEB_ROOT=
# Set to false to switch off the relay lab at /lab/.
# LAB=true

# Raise these on a server that bot load tests hit from one machine (npm run bots -- --rooms 200).
# MAX_CONNECTIONS_PER_IP=32
# ROOMS_PER_IP_PER_10_MIN=20
