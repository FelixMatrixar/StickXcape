# Copy this file to .env in the same folder. Never commit .env. Every setting is optional.

PORT=8080

# Origin used in invite links. Without it, links use the address the page was opened at.
# PUBLIC_URL=https://your-tunnel.example.com
# Set to 1 behind one proxy or tunnel (Fly.io, cloudflared) so links and IPs come out right.
# TRUST_PROXY=1

# Meta Model API key. Leave it empty to get canned move names and tips.
MODEL_API_KEY=
# AI_MODEL=muse-spark-1.3
# AI_MOVE_NAMES_PER_DAY=30
# AI_MATCH_TIPS_PER_DAY=60

# Password for /admin and /metrics (sign in as "admin"). Without it they're open locally and off in production.
# ADMIN_TOKEN=
# Slack or Discord webhook for the alert when AI errors pass 5%.
# ALERT_WEBHOOK_URL=

# Folder with the game client's build, served instead of the test page.
# WEB_ROOT=
# Set to false to switch off the relay lab at /lab/.
# LAB=true

# Raise these on a server that bot load tests hit from one machine (npm run bots -- --rooms 200).
# MAX_CONNECTIONS_PER_IP=32
# ROOMS_PER_IP_PER_10_MIN=20
